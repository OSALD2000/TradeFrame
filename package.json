{
  "name": "tradeframe",
  "version": "0.7.6",
  "private": true,
  "description": "A local-first desktop trading journal for capturing charts and documenting setups.",
  "main": "dist-electron/main.js",
  "author": "OSALD2000",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OSALD2000/TradeFrame.git"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "start": "npm run build && electron .",
    "package": "npm run check && node scripts/package.mjs && node scripts/verify-package.mjs",
    "check": "npm run format:check && npm run build && npm test",
    "test": "node --test --test-isolation=none tests/*.test.cjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.8.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "electron": "45.2.2",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  },
  "config": {
    "microsoftClientId": "09c42f94-4515-4051-ab93-eebf431f547e"
  }
}
